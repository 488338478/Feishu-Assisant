{
  "permissions": {
    "allow": [
      "Bash(lark-cli:*)"
    ],
    "deny": [
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash(lark-cli api DELETE:*)",
      "Bash(lark-cli drive +delete:*)",
      "Bash(lark-cli auth login:*)",
      "Bash(lark-cli --profile * auth login:*)",
      "Bash(lark-cli auth logout:*)",
      "Bash(lark-cli --profile * auth logout:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)"
    ]
  }
}
