# ══════════════════════════════════════════════════════════════
# 飞书助手部署环境变量（systemd EnvironmentFile 引用）
# ══════════════════════════════════════════════════════════════

# 飞书应用凭证（必填）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Claude API 按量认证（可选；留空时由 Claude CLI 使用其环境变量/settings/原生认证）
ANTHROPIC_API_KEY=sk-ant-xxx

# lark-cli profile 名（必填，需提前 lark-cli 登录配置）
LARK_CLI_PROFILE=assistant-bot

# 可选：机器人的额外 user_id/union_id，逗号分隔；通常不需要填写
# ASSISTANT_BOT_IDS=

# 路径（可选，默认相对包目录；服务器建议显式指定）
# ASSISTANT_DATA_DIR 同时保存会话、记忆、审计日志、群聊原文库和群聊检索热配置。
ASSISTANT_DATA_DIR=/srv/agent/data
ASSISTANT_PROFILES_DIR=/srv/agent/assistant/profiles
CLAUDE_EXE=/srv/agent/npm/bin/claude
# 服务器部署锁定 CLI 版本，关闭运行期自动升级；版本升级应走部署验收流程。
DISABLE_AUTOUPDATER=1

# 使用兼容 Anthropic 协议的企业网关时按需填写；直连 Anthropic 时保持注释。
# ANTHROPIC_BASE_URL=https://gateway.example.com
# ANTHROPIC_AUTH_TOKEN=replace-me

# dev 模式：P4 工作区根目录（启用 dev 群前必填；p4 登录用 p4 自身 ticket 管理）
# P4_WORKSPACE=/srv/depot

# thesis 模式：毕设项目目录（仅本地使用）
# THESIS_DIR=/path/to/thesis

# 可选：单条消息处理超时（秒）
# CLAUDE_TIMEOUT=300
